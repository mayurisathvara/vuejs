<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg_rounded"
    android:padding="24dp"
    android:elevation="8dp"
    android:gravity="center">

    <ImageView
        android:id="@+id/popup_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_check_circle"
        android:layout_gravity="center"
        android:contentDescription="icon" />

    <TextView
        android:id="@+id/popup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Call Tracking Active"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#222"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/popup_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Call details have been securely pushed to the server."
        android:textSize="15sp"
        android:textColor="#555"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <Button
        android:id="@+id/popup_ok"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:text="OK"
        android:background="@drawable/popup_btn_rounded"
        android:textColor="#222"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_gravity="center" />

</LinearLayout> 