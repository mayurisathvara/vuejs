<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" only blocks pre-Android-12 backup and cloud backup.
  Android 12+ device-to-device transfer (new-phone setup) is a separate mechanism
  that ignores allowBackup, so it must be disabled explicitly here to keep call
  logs and the auth token from copying to a new device outside the app's own login.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
